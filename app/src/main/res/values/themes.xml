<resources>
    <style name="Theme.NHTFitness" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/nht_background</item>
        <item name="android:navigationBarColor">@color/nht_background</item>
        <item name="android:windowBackground">@color/nht_background</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Theme.NHTFitness.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nht_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_nht_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.NHTFitness</item>
    </style>
</resources>
